# ==============================================================================
# VARUNA 2047: Environment Configuration Template
# National Earth Intelligence for Agricultural & Environmental Resilience
# Hack for Social Cause (HSC) — VBYLD 2027 | Team: bulls_eye
# ==============================================================================
# Instructions:
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# No paid API keys are required for core functionality.
# All baseline satellite COGs, climate feeds, and basemaps use open public endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Metadata & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="VARUNA 2047"
PROJECT_TAGLINE="National Earth Intelligence for Agricultural and Environmental Resilience"
VERSION="1.0.0"

# FastAPI Backend Host & Port
API_HOST="0.0.0.0"
API_PORT=8000
API_V1_STR="/api"

# Allowed Cross-Origin Resource Sharing (CORS) Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# ------------------------------------------------------------------------------
# Remote Earth Observation & Ingestion Data Feeds (Open Public Endpoints)
# ------------------------------------------------------------------------------
# NOAA Oceanic Niño Index (ONI) monthly time-series
NOAA_ONI_URL="https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt"

# NASA POWER Agroclimatology monthly meteorology endpoint
NASA_POWER_BASE="https://power.larc.nasa.gov/api/temporal/monthly/point"

# ISRO Bhuvan Open Web Map Service (WMS)
ISRO_BHUVAN_WMS="https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms"

# Element84 / AWS Open Data Sentinel-2 Cloud-Optimized GeoTIFFs (COG) Archive
SENTINEL_COG_BASE="https://sentinel-cogs.s3.us-west-2.amazonaws.com"

# ------------------------------------------------------------------------------
# Frontend Client Configuration
# ------------------------------------------------------------------------------
# Public URL for Next.js to reach FastAPI backend
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"

# ------------------------------------------------------------------------------
# Optional Commercial Provider Keys (NOT REQUIRED - Default runs completely free)
# ------------------------------------------------------------------------------
# If you wish to switch from the default open Esri Dark Canvas to Mapbox:
# NEXT_PUBLIC_MAPBOX_TOKEN=""

# If you wish to connect authenticated ISRO Bhoonidhi / Planet Labs APIs:
# ISRO_BHOONIDHI_TOKEN=""
# PLANET_API_KEY=""
