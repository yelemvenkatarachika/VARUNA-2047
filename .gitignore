# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Node.js & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Configurations & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Large Raw Satellite GeoTIFFs (generated or downloaded locally during ingest)
data/raw/satellite/*.tif
data/raw/satellite/*.tiff
data/raw/satellite/*.SAFE
data/raw/satellite/*.zip

# Temporary Generated Reports (keep structure and templates)
reports/generated/*.tmp
reports/generated/*.temp
reports/generated/*.pdf
reports/generated/*.temp
